AZURE_AI_FOUNDRY_BASE_URL=https://YOUR-RESOURCE.openai.azure.com/openai/v1/
AZURE_AI_FOUNDRY_API_KEY=replace-with-your-key
AZURE_AI_FOUNDRY_DEPLOYMENT=gpt-6-luna
MANUAL_REVIEW_CONFIDENCE_THRESHOLD=0.80
MAX_UPLOAD_BYTES=20971520
MAX_ARCHIVE_FILES=100
MAX_ARCHIVE_UNCOMPRESSED_BYTES=104857600
MAX_PDF_PAGES=25
MAX_CONCURRENT_EXTRACTIONS=8
REQUEST_TIMEOUT_SECONDS=90
REQUEST_DEADLINE_SECONDS=200
EXTRACTION_PASSES=2
LOG_MODEL_RESPONSES=false
